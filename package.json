{
  "name": "pimkey",
  "productName": "Pimkey",
  "version": "0.2.0",
  "description": "Coffre-fort local : mots de passe, documents d'identité, cartes et notes, chiffrés par un mot de passe maître",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c magenta,cyan \"vite\" \"wait-on tcp:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "test:vault": "node scripts/test-vault.cjs",
    "test:bridge": "node scripts/test-bridge.cjs",
    "extension": "node scripts/extension.cjs",
    "icons": "node scripts/make-icons.cjs",
    "dist": "node scripts/extension.cjs && vite build && electron-builder --win",
    "release": "node scripts/extension.cjs && vite build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "fr.yalma.pimkey",
    "productName": "Pimkey",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "build/icon.png",
      "package.json",
      "!node_modules/koffi/{src,vendor,doc}/**",
      "!node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}_*/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Pimkey-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Pimkey"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Pimpuss",
        "repo": "pimkey"
      }
    ],
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "asarUnpack": [
      "node_modules/koffi/build/koffi/win32_*/**",
      "electron/native-host.cjs"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron-updater": "6.6",
    "koffi": "^2.16.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  }
}
